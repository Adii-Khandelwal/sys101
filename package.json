{
  "name": "sys101",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "verify:figures": "node scripts/verify-figures.mjs",
    "verify:news": "node scripts/verify-news.mjs",
    "verify:reads": "node scripts/verify-reads.mjs",
    "verify:landmarks": "node scripts/verify-reads.mjs",
    "verify:background": "node scripts/verify-background.mjs",
    "check:news": "node scripts/check-news.mjs",
    "check:diagrams": "node scripts/check-diagram-overflow.mjs",
    "audit:figures": "node scripts/audit-figures.mjs",
    "check:tour": "node scripts/check-tour.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "check:ui": "node scripts/ui-audit.mjs",
    "pipeline:fetch": "node pipeline/fetch-rss.mjs",
    "pipeline:summarize": "node pipeline/summarize.mjs",
    "postbuild": "node scripts/check-news.mjs && node scripts/check-seo.mjs && node scripts/check-diagram-overflow.mjs && node scripts/build-search-index.mjs",
    "search:index": "NEXT_DIST_DIR=.next-search next build && NEXT_DIST_DIR=.next-search node scripts/build-search-index.mjs",
    "check:live-search": "node scripts/check-live-search.mjs",
    "check:topic": "node scripts/check-topic.mjs",
    "readme:stats": "node --no-warnings scripts/readme-stats.mjs",
    "readme:check": "node --no-warnings scripts/readme-stats.mjs --check",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-border": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "graphology": "^0.26.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0",
    "sigma": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
