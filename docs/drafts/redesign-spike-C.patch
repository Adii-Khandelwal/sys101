+/* Theme reveal (ThemeToggle, runThemeReveal): the new theme grows as a circle from the click. The flag is on <html> only while it runs. */
+html[data-theme-reveal]::view-transition-old(root),
+html[data-theme-reveal]::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+
+html[data-theme-reveal]::view-transition-new(root) {
+  animation: theme-reveal var(--dur-reveal) var(--ease-out) both;
+}
+
+html[data-theme-reveal] .site-header {
+  view-transition-name: none; /* else the header cross-fades outside the circle */
+}
+
+@keyframes theme-reveal {
+  from {
+    clip-path: circle(0 at var(--reveal-x) var(--reveal-y));
+  }
+
+  to {
+    clip-path: circle(var(--reveal-r) at var(--reveal-x) var(--reveal-y));
+  }
+}
+
